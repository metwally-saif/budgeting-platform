{
  "name": "vite-project",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b tsconfig.app.json --pretty",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,yml,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,yml,md}\"",
    "codegen": "npx ampx generate graphql-client-code --format graphql-codegen  --out amplify/graphql",
    "sandbox": "npx ampx sandbox",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@ant-design/plots": "^2.3.3",
    "@aws-amplify/ui-react": "^6.7.1",
    "@aws-sdk/signature-v4-crt": "^3.796.0",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/base": "5.0.0-beta.64",
    "@mui/icons-material": "^6.1.10",
    "@mui/lab": "6.0.0-beta.19",
    "@mui/material": "^6.1.10",
    "@mui/x-date-pickers": "^7.23.2",
    "antd": "^5.22.7",
    "aos": "^2.3.4",
    "aws-amplify": "^6.10.0",
    "chart.js": "^4.4.7",
    "date-fns": "2.28.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.1",
    "react-router-dom": "^7.0.1"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.8.0",
    "@aws-amplify/backend-cli": "^1.4.2",
    "@aws-sdk/crc64-nvme-crt": "^3.796.0",
    "@eslint/js": "^9.15.0",
    "@types/aos": "^3.0.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "aws-cdk": "^2.171.1",
    "aws-cdk-lib": "^2.171.1",
    "constructs": "^10.4.2",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1"
  }
